# Add these options to your existing .env; keep your current bot and AI keys.
# Telegram requires a public HTTPS address for the Mini App.
WEBAPP_URL=https://YOUR-SERVICE.onrender.com/app
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
WEBAPP_AUTH_MAX_AGE=86400

# Polling can serve the Mini App too. A webhook is optional.
FORCE_POLLING=1
# WEBHOOK_URL=
